# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=


# DUFYND storefront
# Keep search indexing disabled until the public launch has been approved.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://dufynd.de
NEXT_PUBLIC_SITE_INDEXABLE=false

# DUFYND legal identity shown in Impressum / legal pages.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_OWNER_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_POSTCODE=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_EMAIL=
