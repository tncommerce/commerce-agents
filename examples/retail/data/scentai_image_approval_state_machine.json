    },
    "candidate_discovered": {
      "approved": false,
      "live_eligible": false
    },
    "identity_check_pending": {
      "approved": false,
      "live_eligible": false
    },
    "identity_verified": {
      "approved": false,
      "live_eligible": false
    },
    "rights_or_source_check_pending": {
      "approved": false,
      "live_eligible": false
    },
    "review_ready": {
      "approved": false,
      "live_eligible": false
    },
    "rejected": {
      "approved": false,
      "live_eligible": false
    },
    "approved_feed_image": {
      "approved": true,
      "live_eligible": true
    },
    "approved_manufacturer_image": {
      "approved": true,
      "live_eligible": true
