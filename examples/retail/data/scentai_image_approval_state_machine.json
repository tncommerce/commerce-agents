    },
    {
      "from": "review_ready",
      "to": "approved_licensed_image",
      "trigger": "explicit_visual_approval_licensed_image",
      "action_class": "approval_required"
    },
    {
      "from": [
        "approved_feed_image",
        "approved_manufacturer_image",
        "approved_licensed_image"
      ],
      "to": "revoked",
      "trigger": "identity_rights_or_asset_issue_detected",
      "action_class": "auto_allowed"
    }
