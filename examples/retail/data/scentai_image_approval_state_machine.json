  "candidate_source_classes": [
    "approved_affiliate_feed",
    "manufacturer_official",
    "licensed_asset_provider"
  ],
  "hard_rejections": [
    "wrong_fragrance",
    "wrong_concentration",
    "wrong_volume_or_variant",
    "gift_set_instead_of_bottle",
    "tester_or_refill_instead_of_canonical_bottle",
    "legacy_edition_for_current_canonical_product",
    "generated_bottle_lookalike",
    "unclear_or_unverified_source_rights"
  ],
  "approval_rule": "Final visual approval is a human/user approval gate. Jarvis may discover, normalize, validate and prepare candidates but may not set an approved_* state by itself."
}
