# DUFYND storefront deployment environment
#
# Copy to .env.local for local development or configure the same keys in the
# hosting provider. Do not commit real personal/legal values or credentials.
#
# Public URLs
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# Search indexing
# Keep false until an explicit launch/SEO decision is approved and followed by
# a rebuild plus post-deploy robots/sitemap verification.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Public legal identity shown in Impressum/Datenschutz.
# Replace placeholders only in the deployment environment.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_OWNER_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_POSTCODE=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_EMAIL=
