# DUFYND storefront launch environment
#
# Copy this file to .env.local for local production-like checks or mirror the
# variables in the deployment platform environment. Never commit real secrets.

# Public DUFYND API endpoint used by the storefront.
NEXT_PUBLIC_API_URL=https://api.example.com

# Canonical public storefront URL.
NEXT_PUBLIC_SITE_URL=https://dufynd.de

# Keep false until the site is intentionally opened to search engines.
# Production launch requires an explicit switch to true.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Public legal identity shown in Impressum / legal surfaces.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=TNCommerce
NEXT_PUBLIC_LEGAL_OWNER_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_POSTCODE=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_EMAIL=
